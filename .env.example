# Export these variables in the build/run environment (PowerShell examples in README).
# CS2_API_URL is backend transport. It is NOT the user-facing dashboard.
CS2_API_URL=https://api.example.test
# Required for production builds; embedded by Cargo and overridable at runtime.
# Open Dashboard always targets /scripts/cs2 and strips query/fragment.
CS2_DASHBOARD_URL=https://dashboard.example.test
# Debug-only settings for an isolated local QA instance:
# CS2_API_URL=http://127.0.0.1:8080
# CS2_DASHBOARD_URL=http://127.0.0.1:5173
# CS2_GSI_PORT=31338
